POSTGRES_USER=dmcu
POSTGRES_PASSWORD=dmcu_local
POSTGRES_DB=dmcu
DATABASE_URL=postgresql+psycopg://dmcu:dmcu_local@postgres-prod:5432/dmcu

APP_ENV=production
DEDUP_SALT=change-me

# Auth (OTP email login). SECRET_KEY signs JWTs and hashes OTPs.
SECRET_KEY=change-me-to-a-long-random-value
APP_URL=http://localhost:3000
APP_NAME=DMCU
FROM_EMAIL=DMCU <noreply@example.com>
RESEND_API_KEY=
MAILPIT_URL=http://localhost:8025
SUPPORT_EMAIL=support@example.com
BRAND_COLOR=#111827
EMAIL_LOGO_URL=https://example.com/logo.png
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

# NGC_API_KEY is for docker login nvcr.io / pulling the NIM image — not used by FastAPI.
NGC_API_KEY=
LLM_PROVIDER=nim
NIM_BASE_URL=http://nim-prod:8000
NIM_API_KEY=none
NIM_MODEL=openai/gpt-oss-20b
NIM_CHAT_MODEL=openai/gpt-oss-20b

JOB_BACKEND=procrastinate
REPORT_TIMEZONE=America/Port_of_Spain

# Local development (apps/backend compose + host Ollama), not production:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_CHAT_MODEL=gemma3:4b
# OLLAMA_NUM_CTX=8192
