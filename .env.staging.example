# Staging / UAT: the environment for the staging-infra, staging-backend and
# staging-frontend Dokploy apps. Never commit a filled-in copy.
# Use different secrets from production: a staging token must not open production.

POSTGRES_USER=dmcu
POSTGRES_PASSWORD=change-me-staging
POSTGRES_DB=dmcu
# Must match the three POSTGRES_ values above.
DATABASE_URL=postgresql+psycopg://dmcu:change-me-staging@postgres-staging:5432/dmcu

APP_ENV=staging
DEDUP_SALT=change-me-staging
SECRET_KEY=change-me-to-a-different-long-random-value

# Where testers open the app; used in emailed links.
APP_URL=https://staging.example.com
APP_NAME=DMCU (Staging)
FROM_EMAIL=DMCU Staging <noreply@example.com>
# Required when APP_ENV=staging: the API refuses to start without it.
RESEND_API_KEY=
SUPPORT_EMAIL=support@example.com

# Model. On the server, staging shares production's NIM (nim-prod) over
# dmcu-app-network; nothing else is shared.
LLM_PROVIDER=nim
NIM_BASE_URL=http://nim-prod:8000
NIM_API_KEY=none
NIM_MODEL=openai/gpt-oss-20b
NIM_CHAT_MODEL=openai/gpt-oss-20b

JOB_BACKEND=procrastinate
REPORT_TIMEZONE=America/Port_of_Spain
SURVEY123_TRANSPORT=inprocess
SURVEY123_API_KEY=none
SURVEY123_API_URL=
